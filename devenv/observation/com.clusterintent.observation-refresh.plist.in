<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.clusterintent.observation-refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_ROOT__/devenv/observation/refresh-node-observations.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>21600</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/.local/observation-refresh/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/.local/observation-refresh/stderr.log</string>
</dict>
</plist>
