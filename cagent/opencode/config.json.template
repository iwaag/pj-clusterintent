{
  "$schema": "https://opencode.ai/config.json",
  "model": "__MODEL__",
  "permission": {
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "*--allow-destroy*": "deny",
      "*nctl*prune*": "deny",
      "*braindump*purge*": "deny",
      "*review-delete*": "deny",
      "*playbooks/proxmox/destroy_*": "deny"
    }
  },
  "instructions": ["__AGENTS_PATH__"]
}
