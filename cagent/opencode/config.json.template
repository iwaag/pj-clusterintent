{
  "$schema": "https://opencode.ai/config.json",
  "model": "__MODEL__",
  "permission": {
    "external_directory": "allow",
    "edit": {
      "*": "deny",
      "**/.local/**": "allow",
      ".local/**": "allow",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
      "/var/folders/**": "allow"
    },
    "bash": {
      "*": "allow",
      "*--allow-destroy*": "deny",
      "*nctl*prune*": "deny",
      "*playbooks/proxmox/destroy_*": "deny",
      "*destroy_lxc*": "deny",
      "*destroy_qemu*": "deny",
      "*pct destroy*": "deny",
      "*pct  destroy*": "deny",
      "*qm destroy*": "deny",
      "*qm  destroy*": "deny",
      "*pvesh delete*": "deny",
      "*pvesh  delete*": "deny",
      "*vgremove*": "deny",
      "*lvremove*": "deny",
      "*zpool destroy*": "deny",
      "*wipefs*": "deny",
      "*sgdisk*": "deny",
      "*mkfs*": "deny",
      "*dd if=*of=/dev/*": "deny"
    }
  },
  "instructions": ["__AGENTS_PATH__"]
}
