{
  "$schema": "https://opencode.ai/config.json",
  "model": "__MODEL__",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "external_directory": "deny",
    "edit": "deny",
    "write": "deny",
    "patch": "deny",
    "webfetch": "deny",
    "bash": {
      "*": "deny",
      "uv run --project nctl nctl status": "allow",
      "uv run --project nctl nctl status --json": "allow",
      "uv run --project nctl nctl drift": "allow",
      "uv run --project nctl nctl drift --json": "allow",
      "uv run --project nctl nctl drift --host *": "allow",
      "uv run --project nctl nctl relations": "allow",
      "uv run --project nctl nctl relations --json": "allow",
      "uv run --project nctl nctl actual": "allow",
      "uv run --project nctl nctl actual --json": "allow",
      "uv run --project nctl nctl actual --json --detail": "allow",
      "uv run --project nctl nctl ops list*": "allow",
      "uv run --project nctl nctl ops show *": "allow",
      "uv run cagent/window/incident.py*": "allow",
      "*reconcile*": "deny",
      "*apply*": "deny",
      "*prune*": "deny",
      "*lifecycle*": "deny",
      "*--allow-destroy*": "deny"
    }
  },
  "instructions": ["__AGENTS_PATH__"]
}
